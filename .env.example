# Copy to .env for local overrides. NEVER commit a real .env.
# The docker-compose file reads JWT_SECRET from your environment (or this file
# via `docker compose --env-file`), falling back to an insecure dev default.

# Used to sign/verify JWTs. In real life: a long, random, secret string.
JWT_SECRET=replace-with-a-long-random-string

# Local Postgres dev credentials (safe to share for a laptop-only DB).
POSTGRES_USER=northstar
POSTGRES_PASSWORD=northstar
POSTGRES_DB=northstar
